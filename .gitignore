## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Ww][Ii][Nn][Dd]ows/
x64/
x86/
[Ww][Ii][Nn]arm/
[Ww][Ii][Nn]arm64/

# Build folder
bin/
obj/

# NuGet
*.nupkg
*.snupkg

# CodeWalker vendor
vendor/
