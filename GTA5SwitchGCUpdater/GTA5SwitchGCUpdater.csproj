<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>0.2</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <TrimMode>full</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../vendor/CodeWalker/CodeWalker.Core/CodeWalker.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>
<Target Name="PrepareNet48SingleExe">
  <ItemGroup>
    <Net48SingleExeSidecars Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\net48\*.dll" />
    <Net48SingleExeSidecars Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\net48\$(AssemblyName).exe.config" />
    <Net48SingleExeSidecars Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\net48\$(AssemblyName).pdb" />
    <Net48SingleExeSidecars Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\net48\CodeWalker.Core.pdb" />
    <Net48SingleExeSidecars Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\net48\ShadersGen9Conversion.xml" />
    <Net48SingleExeSidecars Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\net48\strings.txt" />
  </ItemGroup>
  <Delete Files="@(Net48SingleExeSidecars)" />
</Target>
<Target Name="BuildNet48SingleExe" DependsOnTargets="Build;PrepareNet48SingleExe" />
</Project>